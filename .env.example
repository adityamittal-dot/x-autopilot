# ---- Required ----
# Claude subscription token: run `claude setup-token` (locally, a normal `claude` login also works)
CLAUDE_CODE_OAUTH_TOKEN=

# Buffer -> https://publish.buffer.com/settings/api  (free plan includes API; connect only your X account)
BUFFER_API_KEY=

# ---- Optional ----
# Pay-per-token instead of the subscription token
# ANTHROPIC_API_KEY=
# Fallback writer if Claude is unavailable
# GEMINI_API_KEY=
# Any GitHub token with public_repo read. In Actions the built-in GITHUB_TOKEN is used automatically.
GITHUB_TOKEN=

# Override config.json values without editing the file
# BUFFER_CHANNEL_ID=
# GITHUB_USERNAME=

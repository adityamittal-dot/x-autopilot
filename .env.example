# ---- Required ----
# Google AI Studio -> https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=

# Buffer -> https://publish.buffer.com/settings/api  (free plan includes API)
BUFFER_API_KEY=

# ---- Optional ----
# Any GitHub token with public_repo read. In Actions the built-in GITHUB_TOKEN is used automatically.
GITHUB_TOKEN=

# Override config.json values without editing the file
# BUFFER_CHANNEL_ID=
# GITHUB_USERNAME=

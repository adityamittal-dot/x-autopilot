{
  "github": {
    "username": "adityamittal-dot",
    "excludeRepos": [
      "dotfiles",
      "config",
      "PROJECTS-101",
      "x-autopilot"
    ],
    "excludeCommitPatterns": [
      "^merge ",
      "^merge branch",
      "^merge pull",
      "^initial commit$",
      "^wip$",
      "^update$",
      "^updates?$",
      "^fix$",
      "^fixes$",
      "^typo",
      "^bump ",
      "^chore\\(deps\\)",
      "^chore: sync metrics",
      "^chore: log post",
      "^\\.$",
      "^test$",
      "^cleanup$",
      "^formatting$",
      "^lint$",
      "^rename",
      "^revert "
    ],
    "maxRepos": 4
  },
  "identity": {
    "stack": [
      "Django",
      "Python",
      "Next.js",
      "React",
      "TypeScript",
      "Tailwind",
      "PostgreSQL",
      "Docker",
      "Node.js"
    ],
    "interests": [
      "LLM",
      "AI agents",
      "coding agents",
      "static analysis",
      "developer tools",
      "code visualization",
      "full-stack",
      "open source models",
      "web performance",
      "deploying things"
    ],
    "handle": ""
  },
  "schedule": {
    "audienceTimezone": "America/New_York",
    "publishAt": {
      "insight": "10:00",
      "recap": "13:00"
    },
    "jitterMinutes": 20,
    "minLeadMinutes": 5
  },
  "formats": {
    "insight": {
      "maxChars": 275,
      "maxLines": 6,
      "angles": [
        {
          "id": "take",
          "weight": 3,
          "brief": "A clear, defensible opinion on ONE news item, grounded in what it changes for developers who ship. State the take in the first line."
        },
        {
          "id": "what-it-means",
          "weight": 3,
          "brief": "What ONE release, tool, or paper actually changes, in plain words, for someone building real apps. Lead with the consequence, not the announcement."
        },
        {
          "id": "paper-plain",
          "weight": 2,
          "brief": "ONE research paper from the list: its core finding in one sentence a working dev understands, then why it matters in practice. Only if a research item is in the list."
        },
        {
          "id": "stack-angle",
          "weight": 2,
          "brief": "Connect ONE news item to full-stack work in the dev's stack (Django, Next.js, Postgres, Docker): what it changes or what to watch for."
        },
        {
          "id": "roundup",
          "weight": 1,
          "brief": "A one-line hook, then exactly three items from the list that matter to builders, one short line each. No numbering emoji."
        }
      ]
    },
    "recap": {
      "maxChars": 275,
      "maxLines": 7,
      "lookbackDays": 7,
      "angles": [
        {
          "id": "recap-lesson-led",
          "weight": 3,
          "brief": "Open with the single most useful thing learned this week, then what shipped, then what is next."
        },
        {
          "id": "recap-shipped-led",
          "weight": 3,
          "brief": "Open with the most concrete thing shipped this week, then the lesson it taught, then what is being worked on now."
        },
        {
          "id": "recap-bullets",
          "weight": 2,
          "brief": "A one-line hook about the week, then three short lines: something learned, something shipped, something in progress."
        }
      ]
    }
  },
  "news": {
    "lookbackHours": 72,
    "maxItems": 40,
    "briefs": 6,
    "minItems": 4,
    "hnQueries": [
      "AI",
      "LLM",
      "OpenAI",
      "Anthropic",
      "Claude",
      "Gemini",
      "agents",
      "open source model"
    ],
    "hnMinPoints": 60,
    "devtoTags": [
      "ai",
      "llm"
    ],
    "githubTopic": "llm",
    "sources": {
      "hackernews": true,
      "huggingface": true,
      "simonwillison": true,
      "devto": true,
      "lobsters": true,
      "githubRising": true
    },
    "avoidRepeatWindow": 30
  },
  "llm": {
    "provider": "claude",
    "claude": {
      "model": "claude-opus-5-5",
      "effort": "medium",
      "timeoutSeconds": 300
    },
    "worker": {
      "model": "claude-haiku-4-5",
      "thinking": false,
      "timeoutSeconds": 180
    },
    "gemini": {
      "models": [
        "gemini-3-flash",
        "gemini-3.1-flash-lite",
        "gemini-2.5-flash"
      ],
      "temperature": 1.0
    },
    "variants": 3
  },
  "quality": {
    "maxHashtags": 1,
    "maxEmoji": 1,
    "minChars": 80,
    "similarityThreshold": 0.5,
    "similarityWindow": 20,
    "bannedPhrases": [
      "excited to announce",
      "thrilled to",
      "game changer",
      "game-changing",
      "in today's fast-paced",
      "delve",
      "unleash",
      "revolutionize",
      "supercharge",
      "look no further",
      "the future of",
      "let's dive in",
      "buckle up",
      "as an ai",
      "i'm an ai",
      "here's the thing:",
      "little did i know",
      "a thread",
      "🧵",
      "🚀🚀",
      "!!!",
      "#buildinpublic #100daysofcode"
    ],
    "bannedOpeners": [
      "just ",
      "so ",
      "today i ",
      "breaking:",
      "big news"
    ]
  },
  "buffer": {
    "channelService": "twitter",
    "channelId": ""
  },
  "learning": {
    "enabled": true,
    "explorationRate": 0.25,
    "minSamplesPerAngle": 3
  }
}

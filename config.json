      "breaking:",
      "big news"
    ]
  },
  "buffer": {
    "channelService": "twitter",
    "channelId": "6aaebf91ea19ca0bde8a0cc1"
  },
  "learning": {
    "enabled": true,
    "explorationRate": 0.25,
    "minSamplesPerAngle": 3
  }
}

    "username": "adityamittal-dot",
    "excludeRepos": [
      "dotfiles",
      "config",
      "PROJECTS-101",
      "x-autopilot"
    ],
    "excludeCommitPatterns": [
      "^merge ",
      "^merge branch",
      "^merge pull",
      "^initial commit$",
      "^wip$",
      "^update$",
      "^updates?$",
      "^fix$",
      "^fixes$",
      "^typo",
      "^bump ",
      "^chore\\(deps\\)",
      "^chore: sync metrics",
      "^chore: log post",
      "^\\.$",
      "^test$",
      "^cleanup$",
      "^formatting$",
      "^lint$",
      "^rename",
      "^revert "
    ],
    "maxRepos": 4
  },
  "identity": {
    "stack": [
      "Django",
      "Python",
      "Next.js",
      "React",
      "TypeScript",
      "Tailwind",
      "PostgreSQL",
      "Docker",
      "Node.js"
    ],
    "interests": [
      "LLM",
      "AI agents",
      "coding agents",
      "static analysis",
      "developer tools",
      "code visualization",
      "full-stack",
      "open source models",
      "web performance",
      "deploying things",
      "startups",
      "founders",
      "pricing",
      "SaaS",
      "AI costs",
      "unit economics"
    ],
    "handle": "AdityaMittal87",
    "audience": "Builders on X: developers and technical founders who ship products."
  },
  "schedule": {
    "audienceTimezone": "America/New_York",
    "days": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri"
    ],
    "slots": [
      {
        "id": "morning",
        "at": "09:30",
        "type": "insight"
      },
      {
        "id": "midday",
        "at": "13:00",
        "type": "insight",
        "byWeekday": {
          "Wed": "bip",
          "Fri": "recap"
        }
      },
      {
        "id": "evening",
        "at": "17:30",
        "type": "insight"
      }
    ],
    "writeAheadHours": 9,
    "skipIfLateHours": 2,
    "jitterMinutes": 20,
    "minLeadMinutes": 5
  },
  "formats": {
    "insight": {
      "maxChars": 275,
      "maxLines": 6,
      "angles": [
        {
          "id": "builder-take",
          "weight": 3,
          "brief": "A clear, defensible opinion on ONE item: what it changes for people shipping products, developers or founders. The take goes in the first line, the concrete reason from the item right after. Be specific enough that someone could disagree."
        },
        {
          "id": "business-of-ai",
          "weight": 3,
          "brief": "Read ONE item as a business story: pricing, costs, margins, distribution, who wins and who loses, what it does to SaaS or to startups. Use the numbers from the item where they exist."
        },
        {
          "id": "worth-saving",
          "weight": 2,
          "brief": "Make it worth bookmarking. From ONE item: a one-line hook, then 2-3 concrete things a builder should check, change, or try because of it, one short line each. Only specifics the item supports."
        },
        {
          "id": "contrarian",
          "weight": 2,
          "brief": "Push back on the obvious reading of ONE item, with a specific reason from the item. Firm, not snarky. Never dunk on a person or a company."
        },
        {
          "id": "what-it-means",
          "weight": 2,
          "brief": "What ONE release, tool, or deal actually changes, in plain words, for someone building a real product. Lead with the consequence, not the announcement."
        },
        {
          "id": "paper-plain",
          "weight": 1,
          "brief": "ONE research paper from the list: its core finding in one sentence a working builder understands, then why it matters in practice. Only if a research item is in the list."
        },
        {
          "id": "roundup",
          "weight": 1,
          "brief": "A one-line hook, then exactly three items from the list that matter to builders, one short line each. No numbering emoji."
        }
      ]
    },
    "bip": {
      "maxChars": 275,
      "maxLines": 6,
      "lookbackDays": 5,
      "angles": [
        {
          "id": "tried-result",
          "weight": 3,
          "brief": "ONE thing tried in this week's work and what happened. Lead with the result or the surprise, then what was tried. Only what the commits show."
        },
        {
          "id": "problem-solved",
          "weight": 3,
          "brief": "ONE specific problem hit this week and exactly how it was fixed, concrete enough that another builder would bookmark it."
        },
        {
          "id": "decision",
          "weight": 2,
          "brief": "ONE build decision made this week, the tradeoff, and the reason, stated plainly enough that someone could argue with it."
        }
      ]
    },
    "recap": {
      "maxChars": 275,
      "maxLines": 7,
      "lookbackDays": 7,
      "angles": [
        {
          "id": "recap-lesson-led",
          "weight": 3,
          "brief": "Open with the single most useful thing learned this week, then what shipped, then what is next."
        },
        {
          "id": "recap-shipped-led",
          "weight": 3,
          "brief": "Open with the most concrete thing shipped this week, then the lesson it taught, then what is being worked on now."
        },
        {
          "id": "recap-bullets",
          "weight": 2,
          "brief": "A one-line hook about the week, then three short lines: something learned, something shipped, something in progress."
        }
      ]
    }
  },
  "news": {
    "lookbackHours": 72,
    "maxItems": 40,
    "briefs": 6,
    "minItems": 4,
    "hnQueries": [
      "AI",
      "LLM",
      "OpenAI",
      "Anthropic",
      "Claude",
      "Gemini",
      "agents",
      "open source model",
      "startup",
      "YC",
      "SaaS",
      "pricing"
    ],
    "hnMinPoints": 60,
    "devtoTags": [
      "ai",
      "llm"
    ],
    "githubTopic": "llm",
    "sources": {
      "techcrunch": true,
      "hackernews": true,
      "huggingface": true,
      "simonwillison": true,
      "devto": true,
      "lobsters": true,
      "githubRising": true
    },
    "avoidRepeatWindow": 30,
    "maxSourceShare": 0.25,
    "techcrunchFeeds": [
      "https://techcrunch.com/category/artificial-intelligence/feed/",
      "https://techcrunch.com/category/startups/feed/"
    ]
  },
  "llm": {
    "provider": "claude",
    "claude": {
      "model": "claude-opus-5-5",
      "effort": "medium",
      "timeoutSeconds": 300
    },
    "worker": {
      "model": "claude-haiku-4-5",
      "thinking": false,
      "timeoutSeconds": 180
    },
    "gemini": {
      "models": [
        "gemini-3-flash",
        "gemini-3.1-flash-lite",
        "gemini-2.5-flash"
      ],
      "temperature": 1
    },
    "variants": 3
  },
  "quality": {
    "maxHashtags": 1,
    "maxEmoji": 1,
    "minChars": 80,
    "similarityThreshold": 0.5,
    "similarityWindow": 20,
